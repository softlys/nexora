# Copy to deploy/.env for docker compose. Never commit the filled-in file.

# Required on a server: supabase for real use (demo has no sign-in and everyone is admin).
NEXORA_DATA_MODE=supabase

# Supabase project (Settings → API). The anon key is public by design; the service-role key is secret.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ random characters: openssl rand -base64 48
NEXORA_ENCRYPTION_KEY=
# 16+ random characters, shared with the scheduler container: openssl rand -hex 24
CRON_SECRET=

# One reverse proxy (Caddy/nginx) in front of the container appends X-Forwarded-For.
NEXORA_TRUSTED_PROXY_HOPS=1

# Only for NEXORA_DATA_MODE=demo on a server: a shared code visitors enter before the demo opens (8+ characters),
# and the cookie-signing secret (32+ characters).
NEXORA_DEMO_ACCESS_CODE=
NEXORA_SESSION_SECRET=

# Optional
RESEND_API_KEY=
NEXORA_EMAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APP_RELEASE=

# --- Connectors (all optional; see docs/integrations.md) ---
# Public https address for links, payment returns and Twilio signatures.
NEXORA_PUBLIC_URL=
# Inbound webhooks: web forms URL secret (24+ chars), and who inbound records are created as.
NEXORA_HOOK_SECRET=
NEXORA_INBOUND_ORG_ID=
NEXORA_INBOUND_USER_EMAIL=
# Telephony
MANGO_API_KEY=
MANGO_API_SALT=
ZADARMA_API_SECRET=
TWILIO_AUTH_TOKEN=
# Mail over IMAP (Yandex 360, Gmail, Mail.ru): use an app password
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_PROVIDER=
# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# AI assistant: YandexGPT or Claude
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
ANTHROPIC_API_KEY=
# Documents: your legal details, one per line separated by 

NEXORA_SELLER_DETAILS=
# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Yandex 360
YANDEX_DISK_TOKEN=
YANDEX_TELEMOST_TOKEN=
# MoySklad, Slack, Notion
MOYSKLAD_TOKEN=
SLACK_WEBHOOK_URL=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Interface language: ru (default) or en.
NEXORA_LOCALE=ru
