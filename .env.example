# NEXORA environment variables.
# Copy to .env.local and fill in what you need. Nothing here is required for demo mode:
# `npm install && npm run dev` works with no .env file at all.

# --- Data mode -------------------------------------------------------------
# demo     : fictional data stored server-side in a JSON file, no login, user switcher in the top bar.
# supabase : PostgreSQL + Supabase Auth + row-level security.
# If unset, NEXORA uses supabase when the two NEXT_PUBLIC_SUPABASE_* variables below are set, otherwise demo.
# On a production server (NODE_ENV=production) it is REQUIRED: NEXORA refuses to start without it, so a
# forgotten variable can never expose the demo (no sign-in, everyone is admin) on a real host.
NEXORA_DATA_MODE=demo

# --- Demo mode -------------------------------------------------------------
# Where the demo dataset is stored. Default: .data/demo.json (git-ignored).
# Note: serverless hosts have no persistent disk, so demo changes do not survive cold starts there.
NEXORA_DEMO_DATA_PATH=

# Secret used to sign the demo-user cookie (at least 32 characters).
# If unset, a random secret is generated once and stored in .data/session-secret.
NEXORA_SESSION_SECRET=

# --- Supabase mode ---------------------------------------------------------
# Project URL and anon (public) key from Supabase > Project Settings > API.
# The anon key is safe in the browser; access is limited by RLS policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Server-only: never expose it to the browser, never prefix it with NEXT_PUBLIC_, never commit it.
# Used by `npm run supabase:seed` to create demo users and data, and REQUIRED at runtime in supabase mode for
# the automation engine (runs act as a service principal), the hash-chained security log, member invites,
# public API key lookup and webhook deliveries.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts integration signing secrets at rest (AES-256-GCM). At least 32 characters. REQUIRED in supabase mode.
# In demo mode without it, a random key is generated once into .data/encryption-key.
# Changing it makes stored signing secrets unreadable: rotate the secrets of your integrations afterwards.
NEXORA_ENCRYPTION_KEY=

# Password given to the five demo users created by `npm run supabase:seed` (min 12 characters).
DEMO_USER_PASSWORD=

# --- Automation and scheduler ---------------------------------------------------
# Shared secret for /api/cron/scheduler (at least 16 characters). Without it the endpoint returns 503.
# Call it every 5 minutes: curl -X POST -H "Authorization: Bearer $CRON_SECRET" https://<host>/api/cron/scheduler
# (Vercel Cron sends this header automatically when CRON_SECRET is set.) See docs/automation-guide.md.
CRON_SECRET=

# Email for the send_email automation step, through Resend. Without both, email steps are logged as skipped.
RESEND_API_KEY=
NEXORA_EMAIL_FROM=

# Telegram bot for team notifications (the Send to Telegram workflow step). Create the bot with @BotFather,
# add it to your team group or channel, and put the chat id here (groups start with -100; or @channelname).
# Server-only; never prefix with NEXT_PUBLIC_. See Integrations → Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# The bot's @username (without @): each user links it in Settings → Profile to get their own notifications
# (new leads, overdue tasks, workflow notifications) in Telegram. Needs the bot webhook (/api/hooks/telegram).
TELEGRAM_BOT_USERNAME=

# --- Security -------------------------------------------------------------------
# Records read by one user within 5 minutes before a data.bulk_read security event is written. Default: 300.
NEXORA_BULK_READ_THRESHOLD=

# Reverse proxies in front of NEXORA that append to X-Forwarded-For (default 1: Vercel, or one nginx/Caddy).
# The client IP is taken that many entries from the right; entries further left are client-controlled.
# Set 0 if NEXORA is reached directly (then only X-Real-IP is used).
NEXORA_TRUSTED_PROXY_HOPS=

# Extra origins allowed to call server actions, comma-separated (e.g. a preview domain). The app's own host is always allowed.
NEXORA_ALLOWED_ORIGINS=

# --- Integrations -----------------------------------------------------------------
# Development only: set to 1 to let outbound webhooks reach private/loopback addresses (e.g. a local n8n on
# http://localhost:5678). Ignored when NODE_ENV=production, where webhooks must be https and public.
NEXORA_WEBHOOK_ALLOW_PRIVATE=

# Demo mode: optional shared access code (8+ characters) visitors enter before the demo opens.
# NEXORA_DEMO_ACCESS_CODE=

# --- Connectors (all optional; see docs/integrations.md) ---
# Public https address for links, payment returns and Twilio signatures.
NEXORA_PUBLIC_URL=
# Inbound webhooks: web forms URL secret (24+ chars), and who inbound records are created as.
NEXORA_HOOK_SECRET=
NEXORA_INBOUND_ORG_ID=
NEXORA_INBOUND_USER_EMAIL=
# Telephony
MANGO_API_KEY=
MANGO_API_SALT=
ZADARMA_API_SECRET=
TWILIO_AUTH_TOKEN=
# Mail over IMAP (Yandex 360, Gmail, Mail.ru): use an app password
MAIL_IMAP_USER=
MAIL_IMAP_PASSWORD=
MAIL_IMAP_PROVIDER=
# WhatsApp Business (Meta Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# AI assistant: YandexGPT or Claude
YANDEX_GPT_API_KEY=
YANDEX_FOLDER_ID=
ANTHROPIC_API_KEY=
# Documents: your legal details, one per line separated by 

NEXORA_SELLER_DETAILS=
# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Yandex 360
YANDEX_DISK_TOKEN=
YANDEX_TELEMOST_TOKEN=
# MoySklad, Slack, Notion
MOYSKLAD_TOKEN=
SLACK_WEBHOOK_URL=
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Interface language: ru (default) or en.
NEXORA_LOCALE=ru

# Unified inbox: Telegram customer chats (same bot token as above), VK community messages, website chat.
TELEGRAM_WEBHOOK_SECRET=
VK_GROUP_TOKEN=
VK_CONFIRMATION_CODE=
VK_SECRET=
# on = the website chat widget (/api/chat/widget) is enabled; always on in demo mode.
NEXORA_SITE_CHAT=
# https link to your personal data policy (152-FZ), shown in the chat widget's consent line.
NEXORA_PRIVACY_URL=

# Zadarma API key (with ZADARMA_API_SECRET) for calls started from NEXORA.
ZADARMA_API_KEY=

# 1C site exchange (/api/1c/exchange): the login and password entered in 1C.
ONEC_LOGIN=
ONEC_PASSWORD=

# E-mail through SMTP instead of Resend (Yandex 360: smtp.yandex.ru 465; Mail.ru: smtp.mail.ru 465).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# SMS mailings through SMS.ru (api_id from sms.ru → Программистам); optional sender name.
SMSRU_API_ID=
SMSRU_FROM=
